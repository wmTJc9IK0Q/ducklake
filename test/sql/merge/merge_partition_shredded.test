# name: test/sql/merge/merge_partition_shredded.test
# description: MERGE into a partitioned DuckLake table with explicit VARIANT shredding
# group: [merge]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}/merge_partition_shredded

statement ok
ATTACH '{TEST_DIR}/head.duckdb' AS head

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE head.metric_numeric_series_wal (
    series_id BIGINT,
    metric_name VARCHAR,
    metric_type VARCHAR,
    unit VARCHAR,
    description VARCHAR,
    agg_temporality VARCHAR,
    is_monotonic BOOLEAN,
    resource_attributes VARIANT,
    scope_name VARCHAR,
    scope_version VARCHAR,
    scope_attributes VARIANT,
    attributes VARIANT,
    min_timestamp TIMESTAMP,
    max_timestamp TIMESTAMP
)

statement ok
CREATE TABLE ducklake.metric_series_lake (
    series_id BIGINT NOT NULL,
    metric_name VARCHAR NOT NULL,
    metric_type VARCHAR NOT NULL,
    unit VARCHAR,
    description VARCHAR,
    agg_temporality VARCHAR,
    is_monotonic BOOLEAN,
    resource_attributes VARIANT,
    scope_name VARCHAR,
    scope_version VARCHAR,
    scope_attributes VARIANT,
    attributes VARIANT,
    min_timestamp TIMESTAMP NOT NULL,
    max_timestamp TIMESTAMP NOT NULL
)

statement ok
ALTER TABLE ducklake.metric_series_lake SET PARTITIONED BY (metric_name)

# The spec must name every VARIANT column of the table: a column left out is shredded from
# whatever the writer's own analysis pass derives per batch, which does not survive a
# partitioned write (see the skipped section at the end of this file).
statement ok
CALL ducklake.set_option('parquet_shredding',
    'attributes=STRUCT("host.name" VARCHAR)' || chr(10) ||
    'resource_attributes=STRUCT("service.name" VARCHAR)' || chr(10) ||
    'scope_attributes=STRUCT("scope.name" VARCHAR)')

statement ok
INSERT INTO head.metric_numeric_series_wal
SELECT i,
       'metric_' || (i % 10),
       'gauge',
       NULL,
       NULL,
       'cumulative',
       false,
       {'service.name':'svc'}::VARIANT,
       'scope',
       '1',
       {'scope.name':'scope'}::VARIANT,
       {'host.name':'host','other':'other'}::VARIANT,
       '2025-01-01'::TIMESTAMP + i * INTERVAL '1 minute',
       '2025-01-01'::TIMESTAMP + i * INTERVAL '2 minute'
FROM range(100) t(i)

statement ok
MERGE INTO ducklake.metric_series_lake AS t
USING head.metric_numeric_series_wal AS s ON t.series_id = s.series_id
WHEN MATCHED THEN UPDATE SET
    min_timestamp = least(t.min_timestamp, s.min_timestamp),
    max_timestamp = greatest(t.max_timestamp, s.max_timestamp)
WHEN NOT MATCHED THEN INSERT VALUES (
    s.series_id, s.metric_name, s.metric_type, s.unit, s.description,
    s.agg_temporality, s.is_monotonic, s.resource_attributes,
    s.scope_name, s.scope_version, s.scope_attributes, s.attributes,
    s.min_timestamp, s.max_timestamp)

query I
SELECT count(*) FROM ducklake.metric_series_lake
----
100

# every partition file carries the requested shredded layout
query III
SELECT count(DISTINCT CASE WHEN path_in_schema LIKE 'attributes, typed_value, host.name,%' THEN file_name END) > 0,
       count(DISTINCT CASE WHEN path_in_schema LIKE 'resource_attributes, typed_value, service.name,%' THEN file_name END) > 0,
       count(DISTINCT CASE WHEN path_in_schema LIKE 'scope_attributes, typed_value, scope.name,%' THEN file_name END) > 0
FROM parquet_metadata('{DATA_PATH}/**/*.parquet')
----
true	true	true

# Exercise the MATCHED branch over the same partitioned files.
statement ok
UPDATE head.metric_numeric_series_wal
SET max_timestamp = max_timestamp + INTERVAL '1 hour'

statement ok
MERGE INTO ducklake.metric_series_lake AS t
USING head.metric_numeric_series_wal AS s ON t.series_id = s.series_id
WHEN MATCHED THEN UPDATE SET
    min_timestamp = least(t.min_timestamp, s.min_timestamp),
    max_timestamp = greatest(t.max_timestamp, s.max_timestamp)
WHEN NOT MATCHED THEN INSERT VALUES (
    s.series_id, s.metric_name, s.metric_type, s.unit, s.description,
    s.agg_temporality, s.is_monotonic, s.resource_attributes,
    s.scope_name, s.scope_version, s.scope_attributes, s.attributes,
    s.min_timestamp, s.max_timestamp)

query II
SELECT count(*), count(DISTINCT series_id) FROM ducklake.metric_series_lake
----
100	100

query I
SELECT max_timestamp = '2025-01-01 01:00:00'::TIMESTAMP FROM ducklake.metric_series_lake WHERE series_id = 0
----
true

# A shredding spec that does not cover every VARIANT column of the table currently fails in the
# parquet writer, so this section is skipped until DuckDB is fixed.
#
# With >= 2 partition values, the VARIANT columns left out of the spec are shredded from a
# per-batch analysis pass. ExportPreparedLayout() only reports shredding that came from that
# analysis (ColumnWriter::TryExportPreparedShreddingType walks child writers and returns false
# for an explicitly shredded VARIANT), and InitializeSchemaFromPreparedRowGroup() *replaces*
# options.shredding_types with that incomplete layout and rebuilds the column writers. The
# rebuilt writers have fewer leaf columns than the prepared row group, so flushing it indexes
# past the end of the written-statistics unifiers:
#   INTERNAL Error: Attempted to access index 10 within vector of size 9
#     ParquetWriter::FlushColumnStats -> PhysicalCopyToFile::FlushBatch
#     -> PartitionedCopy::FlushPreparedPartitionBatch -> DrainDelayedPartitions
# Reproduces with a plain INSERT too, and with threads=1, so it is not a race. Unskip once
# duckdb exports explicit shredding types (or merges instead of replaces on import).
mode skip

statement ok
CALL ducklake.set_option('parquet_shredding', 'attributes=STRUCT("host.name" VARCHAR)')

statement ok
UPDATE head.metric_numeric_series_wal SET series_id = series_id + 1000

statement ok
MERGE INTO ducklake.metric_series_lake AS t
USING head.metric_numeric_series_wal AS s ON t.series_id = s.series_id
WHEN MATCHED THEN UPDATE SET
    max_timestamp = greatest(t.max_timestamp, s.max_timestamp)
WHEN NOT MATCHED THEN INSERT VALUES (
    s.series_id, s.metric_name, s.metric_type, s.unit, s.description,
    s.agg_temporality, s.is_monotonic, s.resource_attributes,
    s.scope_name, s.scope_version, s.scope_attributes, s.attributes,
    s.min_timestamp, s.max_timestamp)

query I
SELECT count(*) FROM ducklake.metric_series_lake
----
200

mode unskip
